# 改行コードはリポジトリ内では LF に正規化します。
# 開発機が Windows でも、配布物が CRLF 混在にならないようにするためです。
* text=auto eol=lf

# バイナリは変換しません。
*.png binary
*.dll binary
*.so binary
*.dylib binary
*.lib binary
*.exp binary
*.aseprite binary

# macOS の framework バンドルは中身を一切変換しません。実行バイナリには拡張子が無く、
# Info.plist と _CodeSignature も ad-hoc 署名がバイト単位で対象にしているため、
# 改行コード変換が入ると署名が壊れます。
addons/tk_sprite_server/bin/*.framework/** binary

# シェルスクリプトは CRLF だと CI のランナーで実行できません。
*.sh text eol=lf

# AssetLib からのダウンロード（GitHub のタグ ZIP）には addons/ だけを含めます。
# リポジトリ全体（demo, docs, native, tests, tools など）が配布物に入ると、
# 利用者のプロジェクトへ不要なファイルが展開されてしまうためです。
# 参考: Godot ドキュメント「Submitting to the Asset Library」の Recommendations
/**        export-ignore
/addons    !export-ignore
/addons/** !export-ignore
